# Copy to .env and fill in. Never commit the filled-in copy.
#
# Every value here can equally be supplied as a real environment variable, which
# is what the container does - dotenv simply finds no file and reads the process.

# ---- Required -----------------------------------------------------------------

# Signs every session token. MUST be replaced before the shop is reachable from
# the internet: the one in the repository is a placeholder that anybody has read.
# Generate with: openssl rand -base64 48
TOKEN_KEY=

# Where the Express server listens.
PORT=5000

# The storefront's public origin, comma-separated if there is more than one
# (a staging domain alongside the live one, say). This is what the CORS allowlist
# is built from.
#
# It only matters for callers that are not the storefront's own /api handler -
# curl, a health check, or a second client pointed at this API later. The shop
# itself is same-origin and needs none of it.
FRONTEND_URL=http://localhost:3000

# Absolute path to the SQLite file. Unset, the backend uses the usersdb.sqlite
# sitting beside it. In a container this points at the mounted volume, because a
# database written inside the image is lost on the next deploy.
# DATABASE_PATH=/data/usersdb.sqlite

# ---- Sign-in provider --------------------------------------------------------
# phone  - the phone-number flow. Working, and the rollback target for Steam.
# steam  - OpenID 2.0 against Steam. Written and dormant.
AUTH_PROVIDER=phone

# ---- Steam sign-in -----------------------------------------------------------
# Only read when AUTH_PROVIDER=steam. See docs/steam-auth-cutover.md.
#
# STEAM_OPENID_PUBLIC_KEY=   Valve's PEM signing key, newlines as \n
# STEAM_API_KEY=             https://steamcommunity.com/dev/apikey (optional)
# STEAM_RETURN_URL=          https://your-domain/auth/steam/callback
# STEAM_REALM=               the site shown on Steam's authorise screen

# ---- Payment gateway ---------------------------------------------------------
# Nothing is connected yet; the wallet uses its "no gateway" adapter, which says
# so rather than sending anyone to a dead page. The Zarinpal integration is
# already written - switching it on is filling these in.
#
# PAYMENT_PROVIDER=zarinpal
# PAYMENT_MERCHANT_ID=
# PAYMENT_CALLBACK_URL=https://your-domain/api/payments/callback
# PAYMENT_SANDBOX=true
